   `(mode-line-inactive ((,c (:background ,bg-main :foreground ,fg-unused))))
   `(mode-line-active ((,c (:inherit mode-line :background ,bg-block))))
   `(mode-line-buffer-id ((,c (:weight bold))))
   `(mode-line-emphasis ((,c (:foreground ,func :weight bold))))
   `(mode-line-highlight ((,c (:background ,border))))
   ;; faces for the custom mode line in init.el
   `(my/mode-line-evil-normal ((,c (:background ,func :foreground ,bg :weight bold))))
   `(my/mode-line-evil-insert ((,c (:background ,string :foreground ,bg :weight bold))))
   `(my/mode-line-evil-visual ((,c (:background ,keyword :foreground ,bg :weight bold))))
   `(my/mode-line-evil-replace ((,c (:background ,red :foreground ,bg :weight bold))))
   `(my/mode-line-evil-other ((,c (:background ,field :foreground ,bg :weight bold))))
   `(my/mode-line-modified ((,c (:foreground ,keyword))))
   `(my/mode-line-dim ((,c (:foreground ,fg-muted))))
   `(tab-bar ((,c (:background ,bg-main :foreground ,fg-muted))))
