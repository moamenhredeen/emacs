   `(window-divider ((,c (:foreground ,bg-main))))
   `(window-divider-first-pixel ((,c (:foreground ,bg-main))))
   `(window-divider-last-pixel ((,c (:foreground ,bg-main))))
   `(internal-border ((,c (:background ,bg-main))))
   `(child-frame-border ((,c (:background ,border))))
   `(header-line ((,c (:background ,bg-alt :foreground ,fg-muted))))
   `(tooltip ((,c (:background ,bg-main :foreground ,fg))))
   `(help-key-binding ((,c (:background ,bg-block :foreground ,func
