   `(font-lock-comment-face ((,c (:foreground ,comment))))
   `(font-lock-comment-delimiter-face ((,c (:foreground ,comment))))
   `(font-lock-function-name-face ((,c (:foreground ,func))))
   `(font-lock-function-call-face ((,c (:foreground ,fg))))
   `(font-lock-variable-name-face ((,c (:foreground ,fg))))
   `(font-lock-variable-use-face ((,c (:foreground ,fg))))
   `(font-lock-property-name-face ((,c (:foreground ,field))))
   `(font-lock-property-use-face ((,c (:foreground ,field))))
   `(font-lock-constant-face ((,c (:foreground ,field :slant italic))))
   `(font-lock-type-face ((,c (:foreground ,fg))))
   `(font-lock-preprocessor-face ((,c (:foreground ,meta))))
   `(font-lock-number-face ((,c (:foreground ,number))))
   `(font-lock-escape-face ((,c (:foreground ,keyword))))
   `(font-lock-regexp-grouping-backslash ((,c (:foreground ,keyword))))
   `(font-lock-regexp-grouping-construct ((,c (:foreground ,keyword))))
   `(font-lock-negation-char-face ((,c (:foreground ,keyword))))
   `(font-lock-operator-face ((,c (:foreground ,fg))))
   `(font-lock-bracket-face ((,c (:foreground ,fg))))
   `(font-lock-delimiter-face ((,c (:foreground ,fg))))
   `(font-lock-punctuation-face ((,c (:foreground ,fg))))
   `(font-lock-misc-punctuation-face ((,c (:foreground ,fg))))
   `(font-lock-warning-face ((,c (:foreground ,yellow))))

   ;; elisp / misc language faces
   `(elisp-shorthand-font-lock-face ((,c (:foreground ,type-par))))
   `(css-selector ((,c (:foreground ,tag))))
   `(css-property ((,c (:foreground ,field))))
