;;; islands-dark-theme.el --- JetBrains Islands Dark for Emacs -*- lexical-binding: t; -*-

;;; Commentary:

;; Port of JetBrains' "Islands Dark" (default look since IntelliJ 2025.3).
;; Colors come from intellij-community:
;;   platform/platform-resources/src/themes/islands/IslandSchemeDark.xml
;;   platform/platform-resources/src/themes/islands/ManyIslandsDark.theme.json
;; Keys the scheme inherits from Darcula (selection, ANSI, diff) are
;; filled in with close values tuned for the darker #191A1C editor.
;;
;; The "islands" look: editor windows use the editor bg, the space
;; between them (window dividers, mode line, tab bar) uses the darker
;; main-window bg.  Turn on `window-divider-mode' to get the gaps.

;;; Code:

(deftheme islands-dark
  "Dark theme based on JetBrains Islands Dark.")

(let* ((c '((class color) (min-colors 89)))
       ;; surfaces
       (bg        "#191A1C")   ; editor / tool window (layer-0)
       (bg-main   "#26282C")   ; main window, between islands (layer-1)
       (bg-alt    "#212326")
       (bg-hl     "#1F2024")   ; caret row
       (bg-block  "#2B2D30")   ; code block / template language
       (bg-inlay  "#393B40")
       (bg-paren  "#43454A")
       (border    "#33353B")
       (guide     "#323438")
       ;; text
       (fg        "#BCBEC4")
       (fg-strong "#D1D3D9")
       (fg-muted  "#9FA2A8")
       (fg-dim    "#868A91")
       (fg-unused "#6F737A")
       (comment   "#7A7E85")
       (linum     "#4B5059")
       (linum-cur "#A1A3AB")
       (caret     "#CED0D6")
       ;; syntax
       (keyword   "#CF8E6D")
       (string    "#6AAB73")
       (number    "#2AACB8")
       (doc       "#5F826B")
       (doc-tag   "#67A37C")
       (func      "#56A8F5")
       (field     "#C77DBB")
       (meta      "#B3AE60")
       (type-par  "#16BAAC")
       (tag       "#D5B778")
       (todo      "#8BB33D")
       (link      "#548AF7")
       ;; accents / states
       (sel       "#214283")
       (sel-list  "#2A4371")
       (sel-dim   "#233558")
       (tab-line  "#2E4D89")
       (red       "#F75464")
       (red-wave  "#FA6675")
       (yellow    "#F2C55C")
       (info      "#857042")
       (search    "#2D543F")
       (search-cur "#114957")
       (under-car "#373B39")
       (under-wr  "#402F33")
       (vc-add    "#549159")
       (vc-mod    "#375FAD")
       (vc-del    "#868A91")
       (diff-add-bg "#1F3623")
       (diff-add-hi "#2C4F33")
       (diff-mod-bg "#1E2C4A")
       (diff-del-bg "#3D2326")
       (diff-del-hi "#5A2F34"))

  (custom-theme-set-faces
   'islands-dark

