                       :box (:line-width 4 :color ,sel-dim)
                       :underline (:color ,tab-line :position t)))))
   `(tab-bar-tab-inactive ((,c (:background ,bg-main :foreground ,fg-muted
                                :box (:line-width 4 :color ,bg-main)))))
   `(tab-line ((,c (:background ,bg-main :foreground ,fg-muted))))
   `(tab-line-tab ((,c (:background ,bg-main :foreground ,fg-muted))))
   `(tab-line-tab-current ((,c (:background ,sel-dim :foreground ,fg-strong))))
   `(tab-line-tab-inactive ((,c (:background ,bg-main :foreground ,fg-muted))))
   `(tab-line-highlight ((,c (:background ,border))))

