   ;; org: styled like a rendered page.  Headings get vertical padding
   ;; (a box in the bg color); anything that needs column alignment
   ;; inherits `fixed-pitch' so it stays monospace when the buffer body
   ;; runs in `variable-pitch-mode'.
   `(org-level-1 ((,c (:foreground ,keyword :weight bold :height 1.6
                       :box (:line-width (1 . 10) :color ,bg)))))
   `(org-level-2 ((,c (:foreground ,func :weight bold :height 1.4
                       :box (:line-width (1 . 8) :color ,bg)))))
   `(org-level-3 ((,c (:foreground ,field :weight bold :height 1.25
                       :box (:line-width (1 . 6) :color ,bg)))))
   `(org-level-4 ((,c (:foreground ,number :weight bold :height 1.15
                       :box (:line-width (1 . 4) :color ,bg)))))
   `(org-level-5 ((,c (:foreground ,string :weight bold :height 1.1))))
   `(org-level-6 ((,c (:foreground ,meta :weight bold :height 1.05))))
   `(org-level-7 ((,c (:foreground ,tag :weight bold))))
   `(org-level-8 ((,c (:foreground ,type-par :weight bold))))
   `(org-document-title ((,c (:foreground ,fg-strong :weight bold :height 1.8
                              :box (:line-width (1 . 12) :color ,bg)))))
   `(org-document-info ((,c (:foreground ,fg-muted))))
   `(org-document-info-keyword ((,c (:inherit fixed-pitch :foreground ,comment :height 0.85))))
   `(org-meta-line ((,c (:inherit fixed-pitch :foreground ,comment :height 0.85))))
   `(org-drawer ((,c (:inherit fixed-pitch :foreground ,comment :height 0.85))))
   `(org-special-keyword ((,c (:inherit fixed-pitch :foreground ,comment :height 0.85))))
   `(org-property-value ((,c (:inherit fixed-pitch :foreground ,fg-muted :height 0.85))))
   `(org-tag ((,c (:foreground ,meta :weight normal :height 0.85))))
   `(org-todo ((,c (:inherit fixed-pitch :foreground ,red :weight bold))))
   `(org-done ((,c (:inherit fixed-pitch :foreground ,string :weight bold))))
   `(org-headline-done ((,c (:foreground ,fg-unused))))
   `(org-date ((,c (:inherit fixed-pitch :foreground ,number :underline t))))
   `(org-scheduled ((,c (:foreground ,fg))))
   `(org-scheduled-today ((,c (:foreground ,func))))
   `(org-scheduled-previously ((,c (:foreground ,keyword))))
   `(org-upcoming-deadline ((,c (:foreground ,keyword))))
   `(org-warning ((,c (:foreground ,red))))
   `(org-agenda-structure ((,c (:foreground ,func :weight bold))))
   `(org-agenda-date ((,c (:foreground ,fg-strong))))
