   `(match ((,c (:background ,search))))
   `(completions-common-part ((,c (:foreground ,func :weight bold))))
   `(completions-first-difference ((,c (:foreground ,keyword))))
   `(completions-annotations ((,c (:foreground ,comment))))
   `(separator-line ((,c (:foreground ,border :underline ,border))))

   ;; line numbers
