   `(fringe ((,c (:background ,bg :foreground ,linum))))
   `(region ((,c (:background ,sel :extend t))))
   `(secondary-selection ((,c (:background ,sel-dim :extend t))))
   `(highlight ((,c (:background ,sel-list))))
   `(hl-line ((,c (:background ,bg-hl :extend t))))
   `(shadow ((,c (:foreground ,comment))))
   `(minibuffer-prompt ((,c (:foreground ,func :weight bold))))
   `(link ((,c (:foreground ,link :underline t))))
   `(link-visited ((,c (:foreground ,field :underline t))))
   `(error ((,c (:foreground ,red :weight bold))))
   `(warning ((,c (:foreground ,yellow :weight bold))))
   `(success ((,c (:foreground ,string :weight bold))))
   `(escape-glyph ((,c (:foreground ,keyword))))
   `(homoglyph ((,c (:foreground ,keyword))))
   `(nobreak-space ((,c (:foreground ,fg-unused :underline t))))
   `(trailing-whitespace ((,c (:background ,diff-del-bg))))
   `(whitespace-space ((,c (:foreground ,guide))))
   `(whitespace-tab ((,c (:foreground ,guide))))
   `(whitespace-newline ((,c (:foreground ,guide))))
   `(whitespace-trailing ((,c (:background ,diff-del-bg))))
   `(whitespace-line ((,c (:background ,bg-alt))))
   `(fill-column-indicator ((,c (:foreground ,guide))))
