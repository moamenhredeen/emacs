   `(compilation-info ((,c (:foreground ,string))))
   `(compilation-line-number ((,c (:foreground ,linum-cur))))
   `(compilation-mode-line-fail ((,c (:foreground ,red :weight bold))))
   `(compilation-mode-line-exit ((,c (:foreground ,string :weight bold))))

   ;; lsp-mode
   `(lsp-face-highlight-read ((,c (:background ,under-car))))
   `(lsp-face-highlight-textual ((,c (:background ,under-car))))
   `(lsp-face-highlight-write ((,c (:background ,under-wr))))
   `(lsp-inlay-hint-face ((,c (:background ,bg-inlay :foreground ,fg-dim :height 0.9))))
   `(lsp-face-semhl-deprecated ((,c (:strike-through ,fg))))
   `(lsp-face-semhl-property ((,c (:foreground ,field))))
   `(lsp-face-semhl-static ((,c (:slant italic))))
   `(lsp-face-semhl-type-parameter ((,c (:foreground ,type-par))))
   `(lsp-face-semhl-interface ((,c (:foreground ,fg))))
   `(lsp-face-semhl-namespace ((,c (:foreground ,fg))))
   `(lsp-face-semhl-method ((,c (:foreground ,fg))))
   `(lsp-face-semhl-function ((,c (:foreground ,fg))))
   `(lsp-face-semhl-parameter ((,c (:foreground ,fg))))
   `(lsp-face-semhl-variable ((,c (:foreground ,fg))))
   `(lsp-face-semhl-enum ((,c (:foreground ,fg))))
   `(lsp-face-semhl-member ((,c (:foreground ,field))))
   `(lsp-face-semhl-macro ((,c (:foreground ,meta))))
   `(lsp-face-semhl-decorator ((,c (:foreground ,meta))))
   `(lsp-face-semhl-label ((,c (:foreground ,fg))))
   `(lsp-face-semhl-number ((,c (:foreground ,number))))
   `(lsp-face-semhl-string ((,c (:foreground ,string))))
   `(lsp-face-semhl-keyword ((,c (:foreground ,keyword))))
   `(lsp-face-semhl-comment ((,c (:foreground ,comment))))
   `(lsp-face-semhl-operator ((,c (:foreground ,fg))))
   `(lsp-face-semhl-constant ((,c (:foreground ,field :slant italic))))
   `(lsp-signature-highlight-function-argument ((,c (:foreground ,func :weight bold))))
   `(lsp-modeline-code-actions-face ((,c (:foreground ,yellow))))
   `(eglot-highlight-symbol-face ((,c (:background ,under-car))))
   `(eglot-inlay-hint-face ((,c (:background ,bg-inlay :foreground ,fg-dim :height 0.9))))
   `(eldoc-highlight-function-argument ((,c (:foreground ,func :weight bold))))

   ;; completion UIs
   `(vertico-current ((,c (:background ,sel-list :extend t))))
   `(vertico-group-title ((,c (:foreground ,comment :slant italic))))
   `(vertico-group-separator ((,c (:foreground ,border :strike-through t))))
   `(orderless-match-face-0 ((,c (:foreground ,func :weight bold))))
   `(orderless-match-face-1 ((,c (:foreground ,keyword :weight bold))))
   `(orderless-match-face-2 ((,c (:foreground ,string :weight bold))))
   `(orderless-match-face-3 ((,c (:foreground ,field :weight bold))))
   `(marginalia-documentation ((,c (:foreground ,comment :slant italic))))
   `(marginalia-key ((,c (:foreground ,keyword))))
   `(consult-preview-line ((,c (:background ,bg-hl))))
   `(consult-highlight-match ((,c (:background ,search))))
   `(consult-file ((,c (:foreground ,fg))))
   `(corfu-default ((,c (:background ,bg-main :foreground ,fg))))
   `(corfu-current ((,c (:background ,sel-list :foreground ,fg-strong))))
   `(corfu-border ((,c (:background ,border))))
   `(corfu-bar ((,c (:background ,fg-dim))))
   `(corfu-annotations ((,c (:foreground ,comment))))
   `(corfu-deprecated ((,c (:foreground ,fg-unused :strike-through t))))
   `(which-key-key-face ((,c (:foreground ,keyword))))
   `(which-key-separator-face ((,c (:foreground ,comment))))
   `(which-key-command-description-face ((,c (:foreground ,fg))))
   `(which-key-group-description-face ((,c (:foreground ,func))))
   `(which-key-local-map-description-face ((,c (:foreground ,string))))

   ;; vc / diff
   `(git-gutter:added ((,c (:background ,vc-add :foreground ,vc-add))))
   `(git-gutter:modified ((,c (:background ,vc-mod :foreground ,vc-mod))))
   `(git-gutter:deleted ((,c (:background ,vc-del :foreground ,vc-del))))
   `(diff-hl-insert ((,c (:background ,vc-add :foreground ,vc-add))))
   `(diff-hl-change ((,c (:background ,vc-mod :foreground ,vc-mod))))
   `(diff-hl-delete ((,c (:background ,vc-del :foreground ,vc-del))))
   `(diff-added ((,c (:background ,diff-add-bg :extend t))))
   `(diff-removed ((,c (:background ,diff-del-bg :extend t))))
   `(diff-changed ((,c (:background ,diff-mod-bg :extend t))))
   `(diff-refine-added ((,c (:background ,diff-add-hi))))
   `(diff-refine-removed ((,c (:background ,diff-del-hi))))
   `(diff-header ((,c (:background ,bg-alt :foreground ,fg))))
   `(diff-file-header ((,c (:background ,bg-alt :foreground ,fg-strong :weight bold))))
   `(diff-hunk-header ((,c (:background ,bg-block :foreground ,fg-muted))))
   `(magit-section-heading ((,c (:foreground ,keyword :weight bold))))
   `(magit-section-highlight ((,c (:background ,bg-hl :extend t))))
   `(magit-branch-local ((,c (:foreground ,func))))
   `(magit-branch-remote ((,c (:foreground ,string))))
   `(magit-branch-current ((,c (:foreground ,func :box (:line-width -1 :color ,func)))))
   `(magit-tag ((,c (:foreground ,meta))))
   `(magit-hash ((,c (:foreground ,comment))))
   `(magit-dimmed ((,c (:foreground ,fg-unused))))
   `(magit-log-author ((,c (:foreground ,field))))
   `(magit-log-date ((,c (:foreground ,comment))))
   `(magit-diff-file-heading ((,c (:foreground ,fg-strong :weight bold))))
