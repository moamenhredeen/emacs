   `(font-lock-keyword-face ((,c (:foreground ,keyword))))
   `(font-lock-builtin-face ((,c (:foreground ,keyword))))
   `(font-lock-string-face ((,c (:foreground ,string))))
   `(font-lock-doc-face ((,c (:foreground ,doc :slant italic))))
